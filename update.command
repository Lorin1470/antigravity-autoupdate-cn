#!/bin/bash
# ==============================================================================
# Google Antigravity macOS 一鍵更新與繁體漢化（Finder 雙擊執行）
# ==============================================================================
DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

# 執行更新腳本
bash "$DIR/update.sh" "$@"
EXIT_CODE=$?

echo ""
if [ $EXIT_CODE -eq 0 ]; then
    echo "======================================================"
    echo " 操作已順利完成！視窗將在 5 秒後自動關閉（或按任意鍵立即退出）..."
    echo "======================================================"
    read -t 5 -n 1 -s || true
else
    echo "======================================================"
    echo " 執行過程中遇到問題，請檢查上方輸出訊息。"
    echo " 按任意鍵退出..."
    echo "======================================================"
    read -n 1 -s
fi
exit $EXIT_CODE
